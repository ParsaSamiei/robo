# Postgres connection strings (see Docs/05_DATABASE_SCHEMA.md, Docs/09_TECHNICAL_ARCHITECTURE.md)
DATABASE_URL=
DIRECT_URL=

# Session/auth secret for admin login (Docs/06_ADMIN_PANEL.md #3-4)
AUTH_SECRET=

# Where uploaded media is stored on disk/VPS — under public/ so files are
# served directly by Next's static file handling, no custom serving route
# needed. Project root: ./public/uploads.
UPLOAD_DIRECTORY=./public/uploads

# Public site URL, used for SEO/OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
