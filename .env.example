# Postgres connection strings (see Docs/05_DATABASE_SCHEMA.md, Docs/09_TECHNICAL_ARCHITECTURE.md)
# On Neon: DATABASE_URL = the pooled connection string (?pgbouncer=true),
# DIRECT_URL = the direct (non-pooled) connection string, used for migrations.
DATABASE_URL=
DIRECT_URL=

# Session/auth secret for admin login (Docs/06_ADMIN_PANEL.md #3-4)
AUTH_SECRET=

# --- Media storage -----------------------------------------------------
# Local disk (dev / VPS / Docker only). Ignored once the ARVAN_* vars
# below are set. Do NOT rely on this on Vercel or any other serverless
# host -- the filesystem there is ephemeral/read-only, so uploads would
# silently fail or vanish. Project root: ./public/uploads.
UPLOAD_DIRECTORY=./public/uploads

# ArvanCloud Object Storage (S3-compatible). Required on Vercel. Get these
# from the Object Storage dashboard in the Arvan panel.
#   ARVAN_ENDPOINT: https://s3.ir-thr-at1.arvanstorage.ir (Simin region) or
#                   https://s3.ir-tbz-sh1.arvanstorage.ir (Shahriar region)
#                   -- must match the region the bucket was created in.
ARVAN_ENDPOINT=
ARVAN_BUCKET=
ARVAN_ACCESS_KEY=
ARVAN_SECRET_KEY=
# Optional: custom/CDN domain to serve uploaded files from instead of the
# default https://<bucket>.<endpoint-host> URL. No trailing slash.
ARVAN_PUBLIC_URL=

# Optional: hero 3D model (.glb) hosted on object storage instead of
# committed to git at public/models/hero-robot.glb. See RobotViewer.tsx.
NEXT_PUBLIC_HERO_MODEL_URL=

# Public site URL, used for SEO/OG tags
NEXT_PUBLIC_SITE_URL=http://localhost:3000
