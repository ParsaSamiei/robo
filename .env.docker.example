# Read automatically by `docker compose` from a file named `.env` in this
# same directory (Compose's own convention -- unrelated to Next's
# .env.local, which isn't used inside the container; see docker-compose.yml's
# `environment:` block instead).
#
# Copy this file to `.env` and fill in real values before running
# `docker compose up -d --build`.

POSTGRES_PASSWORD=
AUTH_SECRET=
NEXT_PUBLIC_SITE_URL=https://example.com
